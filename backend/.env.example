# Comma-separated exact frontend origins allowed to open Socket.IO connections.
# For Vercel, include the production domain and any preview domains you intentionally use.
CORS_ORIGIN=https://your-hushly-domain.vercel.app

# Set true only when the backend is behind a trusted proxy that appends the real client IP
# to X-Forwarded-For. Leave false otherwise.
TRUST_PROXY=false
